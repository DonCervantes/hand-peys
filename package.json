{
  "name": "hand-peys",
  "private": true,
  "version": "0.1.0",
  "description": "Links y QR de cobro en MXNe y USDC sobre Stellar",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "contracts:build": "node scripts/build-contracts.mjs",
    "contracts:test": "cd contracts && cargo test",
    "deploy:contracts": "node scripts/deploy-contracts.mjs"
  },
  "engines": { "node": ">=20" }
}
