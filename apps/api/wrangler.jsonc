// Un solo Worker sirve la API (/api/*) y la web (Workers Static Assets).
// URL: https://hand-peys.cruzcervantesdanieladrianelias.workers.dev
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hand-peys",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ENVIRONMENT": "testnet",
    "NETWORK": "testnet",
    "APP_URL": "https://hand-peys.cruzcervantesdanieladrianelias.workers.dev",
    "POLLAR_API_URL": "https://api.pollar.xyz",
    "KYC_LEVEL1_MONTHLY_LIMIT_MXN": "50000",
    // Temporal mientras el KYC de Pollar está en pausa (ticket POLLAR-1). Solo aplica en testnet.
    "KYC_AUTO_APPROVE": "true"
  },
  "d1_databases": [
    // Testnet (creada 2026-11-26).
    { "binding": "DB", "database_name": "hand-peys-db", "database_id": "80edaf93-9ea3-4576-b588-9f1103d74891", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    // Testnet: hand-peys-kv
    { "binding": "KV", "id": "d55feddeb85e4928989dc0a82da24029" }
  ],
  // Rate limit nativo por IP (no gasta escrituras de KV).
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_PUBLIC", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // Cloudflare Queues requiere el plan Workers Paid. Si está disponible, descomenta:
  // "queues": {
  //   "producers": [{ "binding": "EVENTS_QUEUE", "queue": "hand-peys-events" }],
  //   "consumers": [{ "queue": "hand-peys-events", "max_batch_size": 50 }]
  // },
  // Sin la cola, el indexer procesa los eventos inline (mismo código, idempotente).
  "env": {
    "mainnet": {
      "name": "hand-peys-mainnet",
      "vars": {
        "ENVIRONMENT": "mainnet",
        "NETWORK": "mainnet",
        // Sin KYC de Pollar: cumplimiento aprueba a mano en /admin/cumplimiento.
        "KYC_MANUAL": "true",
        "APP_URL": "https://hand-peys-mainnet.cruzcervantesdanieladrianelias.workers.dev",
        "POLLAR_API_URL": "https://api.pollar.xyz",
        "KYC_LEVEL1_MONTHLY_LIMIT_MXN": "50000"
      },
      "triggers": { "crons": ["* * * * *"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "hand-peys-db-mainnet", "database_id": "5e9c1c14-7020-4118-bcc3-f4e7cae91d98", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "1eadee27091a4122962022e1a660c5f7" }],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_PUBLIC", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } }
      ]
    }
  }
  // Secretos (wrangler secret put ...): POLLAR_SECRET, COMPLIANCE_SIGNER_SECRET, SESSION_SECRET
}
