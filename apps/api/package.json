{
  "name": "@hand-peys/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "deploy:mainnet": "wrangler deploy --env mainnet",
    "db:migrate:local": "wrangler d1 migrations apply hand-peys-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hand-peys-db --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hand-peys/shared": "workspace:*",
    "@hand-peys/stellar": "workspace:*",
    "@stellar/stellar-sdk": "^14.0.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
